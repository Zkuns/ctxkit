{
  "name": "ctxkit-dsh",
  "version": "0.2.0",
  "description": "Progressive Markdown context spaces and sourced session checkpoints for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19.0", "dsh": "0.2.2-rc.3" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "adapter.js", "library.js", "browser-host.js", "client.js", "contracts.js", "vault.js", "engine.js", "prompts.js", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test tests/*.test.js", "check": "node --check index.js && node --check adapter.js && node --check library.js && node --check browser-host.js && node --check client.js && node --check engine.js && node --check vault.js && node --check contracts.js && node --check prompts.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes"]
    }
  }
}
