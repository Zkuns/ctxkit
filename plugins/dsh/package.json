{
  "name": "ctxkit-dsh",
  "version": "0.8.0",
  "description": "Markdown topics, session checkpoints, user habits and shared global state for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.2-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config.js",
    "adapter.js",
    "library.js",
    "browser-host.js",
    "client.js",
    "contracts.js",
    "vault.js",
    "engine.js",
    "prompts.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "desktop-host.js",
    "preferences.js",
    "preference-context.js",
    "global-state.js",
    "global-context.js",
    "record-context.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check config.js && node --check adapter.js && node --check library.js && node --check browser-host.js && node --check client.js && node --check engine.js && node --check vault.js && node --check contracts.js && node --check prompts.js && node --check desktop-host.js && node --check preferences.js && node --check preference-context.js && node --check global-state.js && node --check global-context.js && node --check record-context.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-host-directory-picker-native": "0.2.2-rc.3",
    "@deepseek-ai/dsh-native-command": "0.2.2-rc.3"
  }
}
